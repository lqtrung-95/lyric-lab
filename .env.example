# Public (được đưa vào bundle client) — chỉ URL và anon key của Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Cloudflare Turnstile (chống tạo hàng loạt tài khoản ẩn danh). Site key là công khai; secret chỉ dán vào Supabase Dashboard,
# không đặt trong repo hay .env. Bỏ trống = không dùng captcha.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Sentry (theo dõi lỗi production). DSN không phải bí mật, dùng chung 1 biến cho cả client/server/edge.
# Tạo project Next.js tại sentry.io (gói free đủ dùng ở quy mô beta) rồi dán DSN vào. Bỏ trống = tắt Sentry.
NEXT_PUBLIC_SENTRY_DSN=

# Tài khoản không bị hạn mức phân tích/giải nghĩa/TTS mỗi ngày (email, phân cách bởi dấu phẩy). Dùng khi tự test production.
UNLIMITED_USAGE_EMAILS=

# Tài khoản được ẩn/xóa bài ở tab Khám phá cho mọi người (email, phân cách bởi dấu phẩy).
ADMIN_EMAILS=

# Server only — KHÔNG thêm tiền tố NEXT_PUBLIC_
SUPABASE_SERVICE_ROLE_KEY=
GROQ_API_KEY=
# Khóa Groq thứ hai (cùng gói miễn phí, đếm hạn mức riêng): thử trước OpenRouter khi GROQ_API_KEY hết hạn mức.
FALLBACK_LLM_API_KEY=
OPENROUTER_API_KEY=
YOUTUBE_DATA_API_KEY=
# Bật route thăm dò /api/debug/caption-probe (chỉ trả số liệu). Chuỗi ngẫu nhiên ≥ 16 ký tự; bỏ trống = tắt.
CAPTION_PROBE_SECRET=
# Giọng đọc thần kinh Azure Speech (gói Free F0). Bỏ trống = nút loa dùng giọng hệ thống.
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=

# Nhắc học bằng thông báo đẩy. Sinh khóa: npx tsx scripts/generate-vapid-keys.mts. Thiếu bất kỳ biến nào thì tính năng tự ẩn.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
# Vercel Cron gọi /api/cron/reminders kèm "Authorization: Bearer <CRON_SECRET>". Chuỗi ngẫu nhiên ≥ 16 ký tự.
CRON_SECRET=

# Email (chào mừng, tổng kết tuần, nhắc quay lại) qua Resend. Cần tên miền riêng đã xác thực SPF/DKIM trong Resend. Thiếu một trong hai thì tính năng tự tắt.
RESEND_API_KEY=
# Ví dụ: SongHanzi <no-reply@ten-mien-cua-ban.com>
EMAIL_FROM=
