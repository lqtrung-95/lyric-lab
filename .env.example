# Public (được đưa vào bundle client) — chỉ URL và anon key của Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server only — KHÔNG thêm tiền tố NEXT_PUBLIC_
SUPABASE_SERVICE_ROLE_KEY=
GROQ_API_KEY=
FALLBACK_LLM_API_KEY=
YOUTUBE_DATA_API_KEY=
# Bật route thăm dò /api/debug/caption-probe (chỉ trả số liệu). Chuỗi ngẫu nhiên ≥ 16 ký tự; bỏ trống = tắt.
CAPTION_PROBE_SECRET=
# Giọng đọc thần kinh Azure Speech (gói Free F0). Bỏ trống = nút loa dùng giọng hệ thống.
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=
